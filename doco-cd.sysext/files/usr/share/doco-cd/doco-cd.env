# Copy to /etc/doco-cd/doco-cd.env and adapt.
# All settings: https://doco.cd/latest/App-Settings/
HTTP_PORT=8080
LOG_LEVEL=info
#GIT_ACCESS_TOKEN=
#WEBHOOK_SECRET=
#SOPS_AGE_KEY=
# Multiline values are not supported in this file, use POLL_CONFIG_FILE for YAML.
POLL_CONFIG_FILE=/etc/doco-cd/poll-config.yaml
